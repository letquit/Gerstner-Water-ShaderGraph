{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "117266e6b6f34a9cab4514a8586e4acd",
    "m_Title": "取巧的深度处理",
    "m_Content": "仅靠节点来实现深度折射是非常棘手的。你要么会看到水下物体的重影（残影），加上叠加在上面的折射版本；要么你的折射效果不错，但不幸的是，它连水面以上的部分也一起折射了。\r\n\r\n这是我尝试解决这些问题的方案。",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 581.0,
        "y": 126.0,
        "width": 200.0,
        "height": 161.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

